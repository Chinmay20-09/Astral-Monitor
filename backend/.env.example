[TEMPLATE]
# OrbitShield Backend Configuration (local simulation only — no real credentials)
# Copy to backend/.env and adjust as needed.

# HTTP server bind
PORT=4000
HOST=127.0.0.1

# SQLite database file location (relative to the backend/ directory; absolute paths allowed)
DATABASE_PATH=./data/orbitshield.db

# Simulated vehicle identifier (single-vehicle local simulation)
SPACECRAFT_ID=SAT-01

# Anti-replay freshness window in seconds
MAX_CLOCK_SKEW_SECONDS=60
