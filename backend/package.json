{
  "name": "orbitshield-backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "OrbitShield ST-02 local security gateway backend: HTTP API + SQLite persistence for the spacecraft security simulation.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "cd .. && npx vitest run backend/src/tests"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "orbitshield": "file:.."
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
