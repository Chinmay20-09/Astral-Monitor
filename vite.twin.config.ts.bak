import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';

// OrbitShield ST-02 — Spacecraft Twin screen (:3010).
// Serves the same root OrbitShield app from vite.config.ts at the twin port.
// The shared root app reads activeScreen via the twin entry (src/main.twin.tsx).
export default defineConfig({
  plugins: [react()],
  server: {
    port: 3010,
    host: true,
    // Backends first, then the local security gateway (backend/ on 4000).
    proxy: {
      '/api': {
        target: 'http://127.0.0.1:4000',
        changeOrigin: true
      }
    }
  },
  build: {
    outDir: 'dist',
    emptyOutDir: true
  }
});
